{
  "name": "fold",
  "homepage": "https://ppconde.github.io/fold/",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "watch": "tsc --noEmit --watch",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "build": "tsc && vite build --base=./",
    "lint": "eslint --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "update-types": "npx supabase gen types typescript --project-id \"dvwjchfzwfhxuqlixomh\" > src/types/database.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.78.0",
    "gsap": "^3.13.0",
    "lil-gui": "^0.19.1",
    "react": "^19.2.0",
    "react-dom": "^19.1.1",
    "stats.js": "^0.17.0",
    "three": "^0.179.0",
    "three-orbit-controls": "^82.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.6.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.169.0",
    "@types/webgl2": "^0.0.11",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.35.1",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.1.4",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "3.6.2",
    "sass": "^1.89.2",
    "supabase": "^2.39.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.11",
    "vite-plugin-plain-text": "^1.4.2",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^3.2.4"
  }
}
